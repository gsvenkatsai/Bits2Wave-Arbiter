# ==============================================================================
# PROJECT ARBITER - UNIFIED ENVIRONMENT CONFIGURATION
# ==============================================================================

# SIMULATION - Simulation Parameters (Branch 1)
SIM_TOPOLOGY=5_CELL_CORE
SIM_CARRIER_FREQ_MHZ=2100.0
SIM_TICK_DURATION_MS=100
SIM_TRAFFIC_SCENARIO=2_AM_COLLISION

# ARBITRATION - Arbitration Core Parameters (Branch 2)
ARBITER_MAX_HOLD_TICKS=3
ARBITER_BISECTION_MAX_EVALS=6
ARBITER_WEIGHT_COVERAGE=0.3
ARBITER_WEIGHT_ENERGY=0.2
ARBITER_WEIGHT_INTERFERENCE=0.2
ARBITER_WEIGHT_DROP_RATE=0.3

# DATABASE - Digital Twin & Storage Parameters (Branch 3)
TWIN_EVALUATION_TIMEOUT_MS=100.0
TWIN_MAPE_THRESHOLD_PCT=10.0
SQLITE_DB_PATH=./arbiter_production.db
SQLITE_WAL_MODE=true

# API_SERVER - API & Dashboard Configuration (Branch 4)
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
DASHBOARD_LIVE_BROADCAST_CADENCE_MS=100
